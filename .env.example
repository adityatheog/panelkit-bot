# Coded by Aditya | GitHub- @adityatheog
# =============================================================================
# PanelKit configuration
#
# Copy this file to .env and fill in every value marked REQUIRED.
#   cp .env.example .env
#
# .env is git-ignored. Never commit real credentials to version control.
# On a shared host, restrict it:  chmod 600 .env
# =============================================================================


# -----------------------------------------------------------------------------
# Discord  (REQUIRED)
# -----------------------------------------------------------------------------

# Bot token: Discord Developer Portal -> your application -> Bot -> Reset Token.
# This is the BOT TOKEN, not the OAuth2 client secret. Treat it as a password:
# anyone holding it controls the bot.
DISCORD_TOKEN=

# Application ID: Developer Portal -> your application -> General Information
# -> Application ID. Used to register slash commands. A 17-20 digit snowflake.
CLIENT_ID=

# Optional but strongly recommended during development.
# When set, slash commands register to this single guild and appear instantly.
# When empty, they register globally and can take up to an hour to propagate.
# Right-click your server -> Copy Server ID (Developer Mode must be enabled).
GUILD_ID=

# Prefix for text commands. 1-8 characters, no whitespace.
# Leave as kx! unless you run several instances in the same server.
DEFAULT_PREFIX=kx!


# -----------------------------------------------------------------------------
# Pterodactyl Panel  (REQUIRED)
# -----------------------------------------------------------------------------

# Panel root URL, for example https://panel.example.com
# A trailing slash and an /api or /api/application suffix are stripped
# automatically, but the scheme and host must be correct.
PANEL_URL=

# Application API key: Panel -> Admin -> Application API -> Create New.
# Grant only what this bot uses:
#   Users     read + write   (account create / delete / password reset)
#   Servers   read + write   (server create / delete / suspend / image change)
#   Nests     read           (reading egg variables to build a valid environment)
#   Locations read           (validating deploy.locationId)
# Do NOT grant Nodes, Databases or Allocations write access; they are never called.
# A leaked Application key is equivalent to panel administrator access.
PANEL_APP_KEY=

# Client API key: Panel -> Account -> API Credentials -> Create.
# Client keys have no scopes; they inherit the permissions of the account that
# owns them. Use an account that can access every server this bot manages.
# Used for power actions, live statistics, rename, reinstall, sub-users and files.
PANEL_CLIENT_KEY=


# -----------------------------------------------------------------------------
# Admin access
# -----------------------------------------------------------------------------

# Comma-separated Discord USER ids allowed to run Admin category commands.
# Example: ADMIN_USER_IDS=209384756019283746,180273645019283746
ADMIN_USER_IDS=

# Comma-separated Discord ROLE ids allowed to run Admin category commands.
# Example: ADMIN_ROLE_IDS=987654321098765432
ADMIN_ROLE_IDS=

# If BOTH lists above are empty, the bot falls back to the Discord
# "Administrator" permission and prints a warning at startup. Set at least one
# list before inviting the bot to a public server: admin commands can suspend
# servers and provision accounts for other people.


# -----------------------------------------------------------------------------
# Policy
# -----------------------------------------------------------------------------

# Minimum Discord account age, in days, required to self-register a panel
# account. Raises the cost of throwaway-account abuse. 0 disables the check.
ACCOUNT_AGE_DAYS=90

# Maximum servers a normal user may own. Admin provisioning deliberately
# bypasses this limit.
FREE_SERVER_LIMIT=1

# Credits granted to a new account on creation.
STARTING_CREDITS=0


# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------

# SQLite database file. Created automatically on first start, including its
# parent directory and schema. Back this file up: losing it disconnects Discord
# users from the panel servers they own.
DATABASE_PATH=./data/panelkit.sqlite


# -----------------------------------------------------------------------------
# Networking
# -----------------------------------------------------------------------------

# Per-request timeout against the panel, in milliseconds.
PANEL_TIMEOUT_MS=15000

# Total attempts per panel request, including the first.
# HTTP 429 is retried for any method with Retry-After honoured. 5xx and network
# faults are retried for GET only, because replaying a POST could create a
# second server. Set to 1 to disable retries entirely.
PANEL_MAX_RETRIES=3

# Verify the panel URL and Application API key once at startup.
# Failure only logs a warning; it never prevents the bot from starting.
VERIFY_PANEL_ON_STARTUP=true


# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------

# debug | info | warn | error
# debug logs every panel request line (method and path only, never credentials).
LOG_LEVEL=info

# Liveness file, rewritten every 30 seconds while the bot is healthy.
# scripts/healthcheck.js, the Docker HEALTHCHECK and the systemd unit read it.
# A file is used rather than an HTTP port so the bot never exposes an
# unauthenticated endpoint.
HEARTBEAT_PATH=./data/heartbeat


# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

# production | development
NODE_ENV=production
