# -----------------------------------------------------------------------------
# Runtime data
# -----------------------------------------------------------------------------
# The SQLite database and its write-ahead log. Back these up separately;
# they must never enter version control because they hold user records.
data/
*.sqlite
*.sqlite3
*.db
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Liveness file written by the bot every 30 seconds.
heartbeat

# Logs
logs/
*.log


